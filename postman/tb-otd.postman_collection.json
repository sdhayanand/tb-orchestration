    {
      "name": "1 Orders (REST)",
      "item": [
        {
          "name": "Create order (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$guid}}"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/v1/orders",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderType\": \"TAILORED\",\n  \"channel\": \"STORE\",\n  \"storeId\": \"0412\",\n  \"customerId\": \"C-POSTMAN\",\n  \"promisedDate\": \"2026-12-24\",\n  \"lines\": [\n    {\n      \"sku\": \"MW-SUIT-NAVY-42R\",\n      \"quantity\": 1,\n      \"unitPrice\": 599.99,\n      \"fulfillmentType\": \"STORE_PICKUP\"\n    },\n    {\n      \"sku\": \"ALT-HEM-TROUSER\",\n      \"quantity\": 1,\n      \"unitPrice\": 50.0,\n      \"fulfillmentType\": \"ALTERATION\",\n      \"alteration\": {\n        \"type\": \"HEM\",\n        \"measurementInches\": 31.5,\n        \"tailorShopId\": \"TS-EASTBAY\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json(); pm.test('orderId format', () => pm.expect(b.orderId).to.match(/^ORD-\\d{4}-\\d{6}$/));",
                  "pm.test('status CREATED', () => pm.expect(b.status).to.eql('CREATED'));",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include(b.orderId));",
                  "pm.collectionVariables.set('orderId', b.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order (poll until RESERVED)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/v1/orders/{{orderId}}",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "v1",
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test('lines round-trip', () => pm.expect(b.lines).to.have.lengthOf(2));",
                  "const attempt = Number(pm.collectionVariables.get('pollAttempt') || 0);",
                  "if (b.status !== 'RESERVED' && attempt < 20) { pm.collectionVariables.set('pollAttempt', attempt + 1); setTimeout(() => {}, 1500); postman.setNextRequest('Get order (poll until RESERVED)'); }",
                  "else { pm.collectionVariables.set('pollAttempt', 0); pm.test('status RESERVED via inventory-service', () => pm.expect(b.status).to.eql('RESERVED')); }"
                ]
              }
            }
          ]
        },
