              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:v1=\"http://tailoredbrands.com/legacy/oms/v1\">\n  <soapenv:Body>\n    <v1:SubmitOrderRequest>\n      <v1:Order>\n        <v1:OrderNbr>LEG-PM-{{$timestamp}}</v1:OrderNbr><v1:OrderType>T</v1:OrderType><v1:StoreNbr>0875</v1:StoreNbr>\n        <v1:CustNbr>C-SOAP</v1:CustNbr><v1:OrderDate>2026-10-04T10:00:00</v1:OrderDate>\n        <v1:Lines>\n          <v1:Line><v1:LineNbr>1</v1:LineNbr><v1:SKU>MW-SUIT-CHARCOAL-40R</v1:SKU><v1:Qty>1</v1:Qty><v1:Price>649.99</v1:Price><v1:FulfillType>P</v1:FulfillType></v1:Line>\n          <v1:Line><v1:LineNbr>2</v1:LineNbr><v1:SKU>ALT-HEM-TROUSER</v1:SKU><v1:Qty>1</v1:Qty><v1:Price>50.00</v1:Price><v1:FulfillType>A</v1:FulfillType>\n            <v1:Alteration><v1:Type>HEM</v1:Type><v1:MeasurementInches>32</v1:MeasurementInches><v1:TailorShopNbr>TS-EASTBAY</v1:TailorShopNbr></v1:Alteration></v1:Line>\n        </v1:Lines>\n      </v1:Order>\n    </v1:SubmitOrderRequest>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('SubmitOrderResponse', () => pm.expect(pm.response.text()).to.include('SubmitOrderResponse'));"
                ]
              }
            }
          ]
        },
