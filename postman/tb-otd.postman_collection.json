    {
      "name": "4 Carrier webhook (HMAC)",
      "item": [
        {
          "name": "UPS out-for-delivery (signed, 202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Carrier-Signature",
                "value": "sha256={{sig}}"
              }
            ],
            "url": {
              "raw": "{{webhookUrl}}/v1/carriers/UPS/events",
              "host": [
                "{{webhookUrl}}"
              ],
              "path": [
                "v1",
                "carriers",
                "UPS",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"trackingNumber\":\"1Z999AA10123456784\",\"localActivityDate\":\"20261004\",\"localActivityTime\":\"081500\",\"gmtOffset\":\"-07:00\",\"activityStatus\":{\"type\":\"I\",\"code\":\"OT\",\"description\":\"Out For Delivery Today\"},\"activityLocation\":{\"city\":\"Dublin\",\"stateProvince\":\"CA\",\"countryCode\":\"US\"},\"referenceNumbers\":[{\"code\":\"PO\",\"value\":\"{{orderId}}\"}]}",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.request.body.raw.replace('{{orderId}}', pm.collectionVariables.get('orderId'));",
                  "pm.request.body.raw = body;",
                  "const sig = CryptoJS.HmacSHA256(body, pm.environment.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('sig', sig);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
